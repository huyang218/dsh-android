{
  "name": "dsh-plugin-storage-no-hardlink",
  "version": "0.1.0",
  "description": "Durable-publish shim for dsh on Android: replaces the two link(2) call sites in the session log and attachment stores with an exclusive claim plus rename, because SELinux denies hard links to app domains.",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "android", "selinux", "storage"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huyang218/dsh-android.git",
    "directory": "packages/storage-no-hardlink"
  },
  "type": "module",
  "scripts": {
    "test": "node --test 'test/*.test.js'"
  },
  "files": ["lib", "cordis.patch.yml", "LICENSE"],
  "exports": {
    "./session-persistence": "./lib/session-persistence.js",
    "./attachment": "./lib/attachment.js",
    "./publish": "./lib/publish.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-attachment-local": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence-jsonl": "^0.1.0-rc.7"
  }
}
