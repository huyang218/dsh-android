{
  "name": "dsh-plugin-tool-doc",
  "version": "0.1.0",
  "description": "A read_document tool for dsh: text out of .docx/.xlsx/.pptx with no dependencies beyond node:zlib.",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "docx", "xlsx", "pptx"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huyang218/dsh-android.git",
    "directory": "packages/tool-doc"
  },
  "type": "module",
  "main": "lib/index.js",
  "scripts": { "test": "node --test 'test/*.test.js'" },
  "files": ["lib", "cordis.patch.yml", "LICENSE"],
  "exports": {
    ".": "./lib/index.js",
    "./extract": "./lib/extract.js",
    "./ooxml": "./lib/ooxml.js",
    "./zip": "./lib/zip.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "handheld": { "order": 170 }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
